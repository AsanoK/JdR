        <PAGEOBJECT XPOS="734.96062992126" YPOS="945.290322580645" OwnPage="2" ItemID="231200304" PTYPE="4" WIDTH="243.779527559055" HEIGHT="757.935483870968" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L243.78 0 L243.78 757.935 L0 757.935 L0 0 Z" copath="M0 0 L243.78 0 L243.78 757.935 L0 757.935 L0 0 Z" gXpos="734.96062992126" gYpos="945.290322580645" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="189653040" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Lorem Ipsum          "/>
                <para PARENT="Titre sections"/>
                <ITEXT CH="Neque porro quisquam"/>
                <para PARENT="Titre sous-sections"/>
                <ITEXT CH="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Pellentesque tempor congue tortor, eu dapibus metus porttitor ac. Donec et dignissim sem. Duis sagittis consectetur metus, vel iaculis justo tempor in. Praesent vitae pulvinar mauris. Vivamus convallis condimentum viverra. Maecenas et fermentum neque. Nunc pretium ac nisi id dapibus. Vestibulum sit amet ipsum enim. Nunc facilisis bibendum enim et interdum. Donec sollicitudin accumsan risus, ac porta elit porttitor eu. Suspendisse finibus mattis nulla quis placerat."/>
                <para/>
                <ITEXT CH="est qui dolorem ipsum "/>
                <para PARENT="Titre sous-sections"/>
                <ITEXT CH="Phasellus volutpat orci id dui congue, id vestibulum metus viverra. Nunc volutpat vehicula vestibulum. Proin aliquet pretium ex, in efficitur nibh posuere vel. Duis in euismod nulla. Praesent porttitor elit placerat, euismod nisi sit amet, suscipit sem. Donec et est ipsum. Sed vehicula sagittis odio, vitae varius odio euismod in. Duis maximus sodales metus sed aliquam. Sed cursus euismod scelerisque."/>
                <para/>
                <para/>
                <ITEXT CH="In pharetra massa vitae porttitor elementum. Proin eget sagittis sem, ut posuere sapien. Sed nec nunc laoreet, pulvinar massa eu, blandit enim. Etiam nisl augue, rutrum et lectus eu, commodo fringilla leo. Phasellus interdum fringilla enim a feugiat. Vestibulum ut magna eget orci volutpat lobortis a luctus nunc. Phasellus in libero facilisis, consequat lectus vitae, rhoncus ligula. Pellentesque sollicitudin, odio hendrerit aliquet feugiat, nisi est mollis erat, quis fringilla turpis mauris in neque. Nullam tempus velit eu velit egestas, a semper elit bibendum. Proin vehicula porta nisi, ac ultricies lacus condimentum eget. Pellentesque ac dui non mi sodales blandit. Nullam ante arcu, aliquam vel lobortis sagittis, volutpat in nulla. In ex dui, vehicula id justo vel, finibus volutpat diam. Etiam ullamcorper in enim ut rhoncus. Nullam quis sem dui. Quisque sed odio eget arcu vestibulum aliquet ut et turpis."/>
                <para/>
                <para/>
                <ITEXT CH="Deuxieme section    "/>
                <para PARENT="Titre sections"/>
                <ITEXT CH="Sous-section"/>
                <para PARENT="Titre sous-sections"/>
                <ITEXT CH="Phasellus sed ex eu massa porta cursus eu vitae diam. Vivamus scelerisque, sem sed molestie lobortis, risus odio tempor purus, nec luctus eros libero at libero. Integer sed turpis maximus, vulputate est et, scelerisque dui. Maecenas vel magna quis ante consequat tristique. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Etiam tempor aliquam sodales. Suspendisse potenti. Phasellus dui magna, tincidunt nec erat et, tincidunt cursus nulla. In at libero libero. Nullam malesuada sapien dui, quis consectetur nisi malesuada id. Ut mattis felis eu lectus cursus, in placerat enim vulputate. Aliquam porttitor bibendum mi."/>
                <para/>
                <ITEXT CH="Sous-section 2"/>
                <para PARENT="Titre sous-sections"/>
                <ITEXT CH="Sed non varius diam. Sed pharetra dapibus libero ac auctor. Donec massa libero, ultricies in sem ut, dictum malesuada ex. Praesent mattis, lectus at rhoncus ornare, lorem mi ullamcorper magna, ultricies dictum massa tellus quis risus. Donec nisl turpis, rutrum nec tortor quis, condimentum vestibulum massa. Vestibulum lacinia a felis vitae lacinia. Sed sed auctor libero. Suspendisse eu est sit amet augue malesuada dignissim. Suspendisse condimentum nulla et euismod vestibulum. Aliquam quis tempus purus. "/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="1006.96062992126" YPOS="941.574803149606" OwnPage="2" ItemID="189653040" PTYPE="4" WIDTH="243.779527559055" HEIGHT="761.651003302006" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L243.78 0 L243.78 761.651 L0 761.651 L0 0 Z" copath="M0 0 L243.78 0 L243.78 761.651 L0 761.651 L0 0 Z" gXpos="1006.96062992126" gYpos="941.574803149606" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="231200304"/>
        <PAGEOBJECT XPOS="734.96062992126" YPOS="1823.46456692913" OwnPage="4" ItemID="231204176" PTYPE="4" WIDTH="243.779527559055" HEIGHT="761.651003302006" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L243.78 0 L243.78 761.651 L0 761.651 L0 0 Z" copath="M0 0 L243.78 0 L243.78 761.651 L0 761.651 L0 0 Z" gXpos="734.96062992126" gYpos="941.574803149606" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="231208048" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Test de base"/>
                <para PARENT="Titre sections"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="On lance [pool]d10, on garde le meilleur et on compare à la table de résultat:"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Le pool est composé de :"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="1D10 par défaut (minimum à lancer)"/>
                <para PARENT="Liste normale"/>
                <ITEXT CH="1D10 si le personnage qui lance a la compétence adaptée"/>
                <para PARENT="Liste normale"/>
                <ITEXT CH="1D10 si le personnage bénéficie d'au moins un avantage tactique"/>
                <para PARENT="Liste normale"/>
                <ITEXT CH="1D10 si le personnage maîtrise la compétence adaptée"/>
                <para PARENT="Liste normale"/>
                <ITEXT CH="Si le test est difficile, on retire 1 dé."/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Si le test est dangereux, on retire 2 dés."/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Si un personnage n'a plus de dé, il lance 2 dés (en difficile) ou 3 (en dangereux) et ne garde que le pire des résultats."/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Si un personnage obtient un double, il gagne +1 sur le résultat de ce double. A la discrétion du MJ, un double 10 peut donner une réussite particulièrement bonne."/>
                <breakframe/>
                <para/>
                <ITEXT CH="Attaque contre un PJ"/>
                <para PARENT="Titre sections"/>
                <ITEXT CH="Quand les règles génèrent une attaque contre un PJ, il a droit à un test pour se défendre, dépendant du contexte (Protection dans une fusillade par exemple). En cas de réussite, rien de particulier ne se passe. En cas d'échec, le personnage gagne un point de blessure."/>
                <breakframe/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Test de résistance"/>
                <para PARENT="Titre sections"/>
                <para/>
                <ITEXT CH="Pour les tests de résistance (blessure, stress, fatigue paranormale ou usure), le joueur concerné jette 1D10 par point de cette résistance."/>
                <para PARENT="Default Paragraph Style"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="S'il obtient au moins un résultat &quot;1&quot;, le test est échoué, sinon il est réussi."/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Quand un test de résistance est échoué, on perd tous les points accumulés dans la résistance associée."/>
                <para PARENT="Default Paragraph Style"/>
                <para/>
                <ITEXT CH="Blessures"/>
                <para PARENT="Titre sous-sections"/>
                <ITEXT CH="La résistance &quot;Blessure&quot; est ce qui sépare le personnage d'une potentielle blessure grave, voire mortelle. Gagner trop de points de blessures, c'est jouer avec le destin."/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="                                                                                              "/>
                <para/>
                <ITEXT CH="           "/>
                <para/>
                <para/>
                <ITEXT CH="Complications"/>
                <para PARENT="Titre sous-sections"/>
                <ITEXT CH="Quand un personnage a été blessé au-delà de l'égratignure, il subit une complication :"/>
                <para PARENT="Default Paragraph Style"/>
                <para/>
                <para/>
                <ITEXT CH="Stress"/>
                <para PARENT="Titre sous-sections"/>
                <ITEXT CH="Le stress mesure l'ensemble des éléments qui impactent le mental d'un personnage."/>
                <para/>
                <ITEXT CH="Quand un test de résistance (Stress) est échoué, le personnage lance un dé sur la table suivante:"/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Fatigue paranormale"/>
                <para PARENT="Titre sous-sections"/>
                <ITEXT CH="Chaque utilisation d'une capacité paranormale fait gagner un certain nombre de points de fatigue paranormale (FP)."/>
                <para/>
                <ITEXT CH="A chaque fois que le personnage gagne au moins un point de FP, il réalise un test de Résistance(Fatigue paranormale)."/>
                <para/>
                <para/>
                <ITEXT CH="Si le test échoue, il perd D10 points de FP et fait un jet sur la table des effets paranormaux imprévus. Cet effet paranormal s'active en plus de tout effet de la capacité paranormale."/>
                <para/>
                <ITEXT CH="Si l'action qui a demandé le test était mineure, on ajoute 1 au jet. "/>
                <para/>
                <ITEXT CH="Si l'action qui a demandé le test était majeure, on retire 1 au jet."/>
                <para/>
                <para/>
                <para/>
                <para/>
                <ITEXT CH="Usure"/>
                <para PARENT="Titre sous-sections"/>
                <para/>
                <ITEXT CH="L'usure est au matériel, ce que le stress est aux personnage."/>
                <para/>
                <para/>
                <ITEXT CH="A la fin d'une scène intense pour le matériel (comme les combats), les personnages impliqués gagnent automatiquement un point d'usure."/>
                <breakframe/>
                <para/>
                <ITEXT CH="Statuts"/>
                <para PARENT="Titre sections"/>
                <ITEXT CH=" Blessé: aucun test du personnage ne peut être plus facile que Difficile."/>
                <para PARENT="Liste normale"/>
                <ITEXT CH=" Hors de combat: aucun test du personnage ne peut être plus facile que Dangereux"/>
                <para PARENT="Liste normale"/>
                <ITEXT CH=" Mourant: le personnage ne peut plus agir, et échoue automatiquement les tests demandés"/>
                <para PARENT="Liste normale"/>
                <ITEXT CH=" Fatigué: les tests réalisés par le personnages voient leur difficulté augmentée d'une catégorie"/>
                <para PARENT="Liste normale"/>
                <ITEXT CH=" Engagé: les tests sont difficiles tant qu'une menace partage la zone avec le personnage."/>
                <trail PARENT="Liste normale"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="1006.96062992126" YPOS="1823.46456692913" OwnPage="4" ItemID="231208048" PTYPE="4" WIDTH="243.779527559055" HEIGHT="761.651003302006" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L243.78 0 L243.78 761.651 L0 761.651 L0 0 Z" copath="M0 0 L243.78 0 L243.78 761.651 L0 761.651 L0 0 Z" gXpos="1006.96062992126" gYpos="941.574803149606" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="244685344" BACKITEM="231204176"/>
